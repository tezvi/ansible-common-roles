# {{ ansible_managed }}
# Nginx configuration for LiteLLM reverse proxy
{% if nginx_rate_limit_enabled %}
limit_req_zone $binary_remote_addr zone=litellm_limit:10m rate={{ nginx_rate_limit_requests }};
{% endif %}
# Upstream definition for LiteLLM
upstream litellm_backend {
    server {{ litellm_host }}:{{ litellm_port }};
    keepalive 32;
}
# HTTP server
server {
    listen 80;
    listen [::]:80;
    server_name {{ litellm_domain }} localhost 127.0.0.1;

    # Allow Certbot ACME challenges
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect all other HTTP traffic to HTTPS (or block if SSL not enabled)
    location / {
{% if litellm_ssl_enabled %}
        return 301 https://$host$request_uri;
{% else %}
        return 444;
{% endif %}
    }
}
{% if litellm_ssl_enabled and litellm_cert_exists | default(false) %}
# HTTPS server - only rendered when certificate exists
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ litellm_domain }} localhost 127.0.0.1;

    ssl_certificate /etc/letsencrypt/live/{{ litellm_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ litellm_domain }}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    client_max_body_size {{ nginx_client_max_body_size }};
    access_log /var/log/nginx/litellm_access.log;
    error_log /var/log/nginx/litellm_error.log;

{% if nginx_allowed_ips | length > 0 and nginx_denied_redirect_url | length > 0 %}
    error_page 403 = @denied;
    location @denied {
        return 302 {{ nginx_denied_redirect_url }};
    }
{% endif %}
    # UI - no rate limiting, loads many assets simultaneously
    location /ui {
{% if nginx_allowed_ips | length > 0 %}
        allow 127.0.0.1;
        allow ::1;
{% for ip in nginx_allowed_ips %}
        allow {{ ip }};
{% endfor %}
        deny all;
{% endif %}
        proxy_pass http://litellm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect ~^https?://[^/]+/(.*)$ $scheme://$http_host/$1;
        proxy_connect_timeout {{ nginx_proxy_connect_timeout }};
        proxy_send_timeout {{ nginx_proxy_send_timeout }};
        proxy_read_timeout {{ nginx_proxy_read_timeout }};
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # UI static assets - no rate limiting
    location /litellm-asset-prefix/ {
{% if nginx_allowed_ips | length > 0 %}
        allow 127.0.0.1;
        allow ::1;
{% for ip in nginx_allowed_ips %}
        allow {{ ip }};
{% endfor %}
        deny all;
{% endif %}
        proxy_pass http://litellm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_redirect ~^https?://[^/]+/(.*)$ $scheme://$http_host/$1;
        proxy_buffering on;
        proxy_cache_valid 200 1d;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    location / {
{% if nginx_rate_limit_enabled %}
        limit_req zone=litellm_limit burst={{ nginx_rate_limit_burst }} nodelay;
        limit_req_status 429;
{% endif %}
{% if nginx_allowed_ips | length > 0 %}
        # localhost is always allowed regardless of IP allowlist
        allow 127.0.0.1;
        allow ::1;
        # IP allowlist
{% for ip in nginx_allowed_ips %}
        allow {{ ip }};
{% endfor %}
        deny all;
{% endif %}
        proxy_pass http://litellm_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_redirect ~^https?://[^/]+/(.*)$ $scheme://$http_host/$1;
        proxy_connect_timeout {{ nginx_proxy_connect_timeout }};
        proxy_send_timeout {{ nginx_proxy_send_timeout }};
        proxy_read_timeout {{ nginx_proxy_read_timeout }};
        proxy_buffering off;
        proxy_request_buffering off;
    }
}
{% endif %}
