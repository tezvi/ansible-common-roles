# {{ ansible_managed }}
services:
  litellm_app:
    image: {{ litellm_docker_image }}
    container_name: litellm_app
    restart: always
    volumes:
      - {{ litellm_config_dir }}/config.yaml:/app/config.yaml
    command:
      - "--config=/app/config.yaml"
    ports:
      - "{{ litellm_host }}:{{ litellm_port }}:4000"
    environment:
      STORE_MODEL_IN_DB: "True"
{% if litellm_db_enabled %}
      DATABASE_URL: "postgresql://{{ litellm_db_user }}:{{ litellm_db_password }}@litellm-pgsql-db:5432/{{ litellm_db_name }}"
{% endif %}
    env_file:
      - .env
    networks:
      - litellm-internal
      - ollama-docker
{% if litellm_db_enabled %}
    depends_on:
      litellm-pgsql-db:
        condition: service_healthy
{% endif %}
    healthcheck:
      test:
        - CMD-SHELL
        - python3 -c "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness')"
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
{% if litellm_db_enabled %}
  litellm-pgsql-db:
    image: postgres:16
    restart: always
    container_name: litellm_db
    environment:
      POSTGRES_DB: "{{ litellm_db_name }}"
      POSTGRES_USER: "{{ litellm_db_user }}"
      POSTGRES_PASSWORD: "{{ litellm_db_password }}"
    ports:
      - "127.0.0.1:5432:5432"
    volumes:
{% if litellm_pg_data_dir | length > 0 %}
      - {{ litellm_pg_data_dir }}:/var/lib/postgresql/data
{% else %}
      - postgres_data:/var/lib/postgresql/data
{% endif %}
    networks:
      - litellm-internal
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -d {{ litellm_db_name }} -U {{ litellm_db_user }}"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 30s
{% endif %}
networks:
  litellm-internal:
    driver: bridge
  ollama-docker:
    external: true
{% if litellm_db_enabled and litellm_pg_data_dir | length == 0 %}
volumes:
  postgres_data:
    name: litellm_postgres_data
{% endif %}
