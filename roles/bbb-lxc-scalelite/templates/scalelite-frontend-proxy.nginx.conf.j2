# {{ ansible_managed }}

# HTTP -> HTTPS (certbot will also manage this server block)
server {
  listen 80;
  listen [::]:80;

  server_name {{ bbb_scalelite_frontend_proxy_server_name }};

  location /.well-known/acme-challenge/ {
    root /var/www/html;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# Main HTTPS vhost
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;

  server_name {{ bbb_scalelite_frontend_proxy_server_name }};

  # certbot will maintain these paths
  ssl_certificate /etc/letsencrypt/live/{{ bbb_scalelite_frontend_proxy_server_name }}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/{{ bbb_scalelite_frontend_proxy_server_name }}/privkey.pem;

  # Security headers (minimal)
  add_header X-Content-Type-Options nosniff;
  add_header X-Frame-Options SAMEORIGIN;

  # Redirect only the root path to a configured URL (keep all other paths proxied)
  location = / {
    return 302 {{ bbb_lxc_bbb_redirect_url }};
  }

  # Proxy to *internal* Scalelite docker network (fixed IP)
  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_pass http://{{ bbb_scalelite_frontend_proxy_upstream_ip }}:{{ bbb_scalelite_frontend_proxy_upstream_port }};
  }
}
