# {{ ansible_managed }}
# Environment file used by Scalelite systemd unit files (docker-based).

# Required
URL_HOST={{ bbb_scalelite_lxc.hostname }}
SECRET_KEY_BASE={{ scalelite_secret_base }}
LOADBALANCER_SECRET={{ scalelite_loadbalancer_secret }}

# Local DB/Cache containers (systemd-managed)
SCALELITE_DATA_DIR={{ bbb_scalelite_dir }}/data
SCALELITE_CONFIG_DIR={{ bbb_scalelite_dir }}/config

SCALELITE_POSTGRES_IMAGE={{ bbb_scalelite_postgres_image }}
SCALELITE_POSTGRES_IP={{ bbb_scalelite_docker_ip_postgres }}
SCALELITE_POSTGRES_EXTRA_OPTS={{ bbb_scalelite_postgres_extra_opts }}

# Vars used by the official postgres image (read via docker --env-file)
POSTGRES_DB={{ bbb_scalelite_postgres_db }}
POSTGRES_USER={{ bbb_scalelite_postgres_user }}
POSTGRES_PASSWORD={{ bbb_scalelite_postgres_password }}

SCALELITE_REDIS_IMAGE={{ bbb_scalelite_redis_image }}
SCALELITE_REDIS_IP={{ bbb_scalelite_docker_ip_redis }}
SCALELITE_REDIS_EXTRA_OPTS={{ bbb_scalelite_redis_extra_opts }}

# Build connection URLs for Scalelite containers (use docker container names on the same network)
# NOTE: Values are intentionally unquoted because the app boot process expects raw strings.
DATABASE_URL=postgres://{{ bbb_scalelite_postgres_user }}:{{ bbb_scalelite_postgres_password }}@scalelite-postgres:5432/{{ bbb_scalelite_postgres_db }}
REDIS_URL=redis://{% if bbb_scalelite_redis_password is defined and bbb_scalelite_redis_password|length > 0 %}{{ bbb_scalelite_redis_user }}:{{ bbb_scalelite_redis_password }}@{% endif %}scalelite-redis:6379/0

# Docker host helper vars (required by the official systemd unit examples)
SCALELITE_TAG={{ bbb_scalelite_tag }}
SCALELITE_RECORDING_DIR={{ bbb_scalelite_recordings }}

# Optional / common
NGINX_SSL={{ 'true' if (bbb_scalelite_nginx_ssl | bool) else 'false' }}
NGINX_BEHIND_PROXY={{ 'true' if (bbb_scalelite_nginx_behind_proxy | bool) else 'false' }}
RECORDING_IMPORT_POLL={{ 'true' if (bbb_scalelite_lxc.recording_poll | default(true)) else 'false' }}
POLL_INTERVAL={{ bbb_scalelite_poll_interval }}

# Pass extra docker run options to the nginx container (mount letsencrypt etc.)
SCALELITE_NGINX_EXTRA_OPTS={{ bbb_scalelite_nginx_extra_opts }}

# You can pass additional options to other services if needed
SCALELITE_API_EXTRA_OPTS={{ bbb_scalelite_api_extra_opts }}
SCALELITE_POLLER_EXTRA_OPTS={{ bbb_scalelite_poller_extra_opts }}
SCALELITE_RECORDING_IMPORTER_EXTRA_OPTS={{ bbb_scalelite_recording_importer_extra_opts }}

# Docker network isolation (used by systemd unit docker run commands)
SCALELITE_DOCKER_NETWORK={{ bbb_scalelite_docker_network_name }}
SCALELITE_API_IP={{ bbb_scalelite_docker_ip_api }}
SCALELITE_NGINX_IP={{ bbb_scalelite_docker_ip_nginx }}
SCALELITE_POLLER_IP={{ bbb_scalelite_docker_ip_poller }}
SCALELITE_RECORDING_IMPORTER_IP={{ bbb_scalelite_docker_ip_recording_importer }}

# Protected recordings (optional). Applies to the recording import process. If set to "true", then newly imported
# recordings will have protected links enabled. Default is "false".
PROTECTED_RECORDINGS_ENABLED={{ 'true' if (bbb_scalelite_protected_recordings_enabled | bool) else 'false' }}
