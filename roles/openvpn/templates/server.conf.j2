# OpenVPN Server Configuration
# Generated by Ansible

# Server listening port and protocol
port {{ openvpn_server_port }}
proto {{ openvpn_server_protocol }}
{% if openvpn_server_listen is defined and openvpn_server_listen != '' %}
local {{ openvpn_server_listen }}
{% endif %}
dev {{ openvpn_server_device }}

# SSL/TLS root certificate, server certificate, key, and DH parameters
ca ca.crt
cert server.crt
key server.key
dh dh.pem

{% if openvpn_tls_auth %}
# TLS authentication
tls-auth ta.key 0
key-direction 0
{% endif %}

# VPN tunnel subnet
server {{ openvpn_server_network }} {{ openvpn_server_netmask }}

# Use subnet topology (recommended over net30)
topology subnet

# Maintain a record of client-server virtual IP address associations
ifconfig-pool-persist {{ openvpn_log_dir }}/ipp.txt

{% if openvpn_push_routes is defined and openvpn_push_routes | length > 0 %}
# Push routes to clients
{% for route in openvpn_push_routes %}
push "route {{ route }}"
{% endfor %}
{% endif %}

{% if openvpn_use_nat_alias | default(false) %}
# Push NAT alias route to clients (for subnet conflict resolution)
push "route {{ openvpn_nat_alias_network }} {{ openvpn_nat_alias_netmask }}"
{% endif %}

{% if openvpn_client_to_client %}
# Enable clients to communicate with each other
client-to-client
{% endif %}

# Keepalive ping
keepalive {{ openvpn_keepalive_ping }} {{ openvpn_keepalive_timeout }}

# Cryptographic cipher
cipher {{ openvpn_cipher }}
auth {{ openvpn_auth }}

{% if openvpn_compression is defined and openvpn_compression != 'none' %}
# Enable compression
compress {{ openvpn_compression }}
push "compress {{ openvpn_compression }}"
{% endif %}

# Maximum number of concurrent clients
max-clients {{ openvpn_max_clients }}

# Run OpenVPN with reduced privileges
user {{ openvpn_user }}
group {{ openvpn_group }}

# Persist keys and tunnel across restarts
persist-key
persist-tun

# Status and log files
status {{ openvpn_log_dir }}/openvpn-status.log
log-append {{ openvpn_log_dir }}/openvpn.log
verb {{ openvpn_log_verbosity }}

{% if openvpn_server_protocol == 'udp' %}
# Explicit exit notify (UDP only)
explicit-exit-notify 1
{% endif %}

